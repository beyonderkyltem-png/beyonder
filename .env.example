# Copiar este archivo como ".env" (y NO subirlo a git, ya está en .gitignore).
# Completar los valores reales según corresponda.

# ============================================================
# OBLIGATORIO — MongoDB (ATLAS, Render Managed, o local)
# El bot ya NO usa SQLite: TODO (sesión WhatsApp + datos) vive en Mongo.
# ============================================================
# Ejemplo MongoDB Atlas:
# MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@cluster0.mongodb.net/beyonder?retryWrites=true&w=majority
# Ejemplo Render MongoDB (cuando creás una instancia en Render):
# MONGODB_URI=mongodb://beyonder:password@host:port/beyonder?ssl=true
MONGODB_URI=

# ============================================================
# OPCIONAL — Google Gemini (respuestas por IA cuando mencionan al bot)
# Si no la ponés, los comandos funcionan igual; solo se desactiva la IA.
# ============================================================
GEMINI_API_KEY=

# Prefijos permitidos para los comandos (separados por coma, sin espacios)
PREFIXES=/,.,!

# Nombre que el bot detecta en los mensajes para responder con IA
BOT_TRIGGER_NAME=beyonder

# Máximo de repeticiones permitidas en /spam
SPAM_MAX=50

# LEGACY — DB_PATH (ya NO se usa, se dejó comentado por referencia)
# El bot ahora usa MongoDB, esta variable se ignora.
# DB_PATH=./data/beyonder.db

# Minutos antes de un evento (/org) en los que el bot manda el recordatorio
EVENTO_RECORDATORIO_MIN=60
